new file mode 100644
index 0000000..8842793
--- /dev/null
+++ b/backend/src/api/report_jobs.py
@@ -0,0 +1,61 @@
+from __future__ import annotations
+
+import threading
+import time
+import uuid
+from collections.abc import Callable
+from dataclasses import dataclass, field
+
+
+@dataclass
+class ReportJob:
+    id: str
+    status: str = "PENDING"  # PENDING | RUNNING | DONE | ERROR
+    total: int = 0
+    completed: int = 0
+    result: object | None = None
+    error: str | None = None
+    created_at: float = field(default_factory=time.time)
+
+
+# Executa relatorios longos (muitos hosts/triggers) em background, fora do
+# ciclo request/response HTTP -- evita estourar o timeout do proxy
+# (Nginx/Apache) e do Uvicorn em relatorios que levam minutos. Guardado em
+# memoria (mesmo padrao de InMemorySessionStore em auth.py): nao sobrevive
+# a restart, nao escala com multiplos workers -- suficiente para o uso
+# local/single-instance desta aplicacao.
+class ReportJobStore:
+    def __init__(self, ttl_seconds: int = 3600) -> None:
+        self.ttl_seconds = ttl_seconds
+        self._jobs: dict[str, ReportJob] = {}
+        self._lock = threading.Lock()
+
+    def create(self) -> ReportJob:
+        self._cleanup_expired()
+        job = ReportJob(id=uuid.uuid4().hex)
+        with self._lock:
+            self._jobs[job.id] = job
+        return job
+
+    def get(self, job_id: str) -> ReportJob | None:
+        with self._lock:
+            return self._jobs.get(job_id)
+
+    def run_async(self, job: ReportJob, target: Callable[[ReportJob], object]) -> None:
+        def worker() -> None:
+            job.status = "RUNNING"
+            try:
+                job.result = target(job)
+                job.status = "DONE"
+            except Exception as exc:  # relatado ao frontend via /status, nao derruba o processo
+                job.error = str(exc)
+                job.status = "ERROR"
+
+        threading.Thread(target=worker, daemon=True).start()
+
+    def _cleanup_expired(self) -> None:
+        now = time.time()
+        with self._lock:
+            expired = [jid for jid, job in self._jobs.items() if now - job.created_at > self.ttl_seconds]
+            for jid in expired:
+                self._jobs.pop(jid, None)
