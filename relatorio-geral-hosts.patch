+    def get_last_events_before_batch(
+        self,
+        trigger_ids: list[str],
+        period_start_epoch: int,
+    ) -> dict[str, ZabbixEvent | None]:
+        # Busca o evento imediatamente anterior ao periodo para varias
+        # triggers de uma vez (1 chamada event.get em vez de 1 por trigger).
+        # Usado no relatorio geral (muitos hosts/triggers), onde o numero de
+        # chamadas sequenciais seria proibitivo -- ver
+        # AvailabilityService.calculate_trigger_groups_batched(). Sem
+        # "limit" aqui (limitaria o total, nao por trigger); filtramos
+        # localmente o primeiro evento (mais recente, por causa do DESC) de
+        # cada objectid.
+        result: dict[str, ZabbixEvent | None] = {trigger_id: None for trigger_id in trigger_ids}
+        if period_start_epoch <= 0 or not trigger_ids:
+            return result
+
+        events = self._request(
+            "event.get",
+            {
+                "source": 0,
+                "object": 0,
+                "objectids": trigger_ids,
+                "time_till": period_start_epoch - 1,
+                "output": ["eventid", "clock", "value", "objectid"],
+                "sortfield": ["clock", "eventid"],
+                "sortorder": "DESC",
+            },
+        )
+        for raw_event in events:
+            event = self._to_event(raw_event)
+            if result.get(event.objectid) is None:
+                result[event.objectid] = event
+        return result
+
+    def get_events_in_window_batch(
+        self,
+        trigger_ids: list[str],
+        period_start_epoch: int,
+        period_end_epoch: int,
+    ) -> dict[str, list[ZabbixEvent]]:
+        # Busca os eventos dentro do periodo para varias triggers de uma vez
+        # (mesma motivacao de get_last_events_before_batch acima).
+        result: dict[str, list[ZabbixEvent]] = {trigger_id: [] for trigger_id in trigger_ids}
+        if not trigger_ids:
+            return result
+
+        events = self._request(
+            "event.get",
+            {
+                "source": 0,
+                "object": 0,
+                "objectids": trigger_ids,
+                "time_from": period_start_epoch,
+                "time_till": period_end_epoch,
+                "output": ["eventid", "clock", "value", "objectid"],
+                "sortfield": ["clock", "eventid"],
+                "sortorder": "ASC",
+            },
+        )
+        for raw_event in events:
+            event = self._to_event(raw_event)
+            result.setdefault(event.objectid, []).append(event)
+        for trigger_id, trigger_events in result.items():
+            result[trigger_id] = sorted(trigger_events, key=lambda e: (e.clock, int(e.eventid)))
+        return result
+
