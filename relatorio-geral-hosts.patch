@@ -24,3 +24,30 @@ def load_project_env() -> None:
 def get_cors_origins() -> list[str]:
     raw_origins = os.getenv("CORS_ORIGINS", "http://127.0.0.1:3000,http://localhost:3000")
     return [origin.strip() for origin in raw_origins.split(",") if origin.strip()]
+
+
+# Quantidade de triggerids agrupados por chamada event.get no relatorio
+# geral (calculate_trigger_groups_batched). Um valor menor gera mais
+# chamadas (mais lento, mais leve por chamada); um valor maior gera menos
+# chamadas, porem cada resposta do Zabbix fica maior. Ajustavel sem
+# redeploy via backend/.env.
+def get_report_chunk_size() -> int:
+    raw = os.getenv("REPORT_CHUNK_SIZE", "150")
+    try:
+        value = int(raw)
+    except ValueError:
+        return 150
+    return value if value > 0 else 150
+
+
+# Pausa deliberada (em segundos) entre lotes do relatorio geral -- existe
+# para nao gerar uma rajada de chamadas na API do Zabbix mesmo estando em
+# lotes; aceita-se um relatorio mais lento em troca de nao impactar o
+# funcionamento normal do Zabbix. Ajustavel via backend/.env.
+def get_report_chunk_delay_seconds() -> float:
+    raw = os.getenv("REPORT_CHUNK_DELAY_SECONDS", "0.3")
+    try:
+        value = float(raw)
+    except ValueError:
+        return 0.3
+    return value if value >= 0 else 0.3
