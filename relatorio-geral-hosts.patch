+// --- Relatorio geral em background (muitos hosts/triggers). O calculo
+// roda no servidor fora do ciclo request/response HTTP; o cliente inicia
+// o job, faz polling de status (com progresso) e busca o resultado quando
+// pronto. Ver backend/src/api/report_jobs.py. ---
+export type ReportJobStatus = {
+  status: "PENDING" | "RUNNING" | "DONE" | "ERROR"
+  completed: number
+  total: number
+  error: string | null
+}
+
+export async function startGeneralReport(payload: GroupTriggerAvailabilityRequest): Promise<{ job_id: string }> {
+  return request("/api/availability/report/start", {
+    method: "POST",
+    body: JSON.stringify(payload),
+  })
+}
+
+export async function getReportStatus(jobId: string): Promise<ReportJobStatus> {
+  return request(`/api/availability/report/${jobId}/status`)
+}
+
+export async function getReportResult(jobId: string): Promise<GroupTriggerAvailability> {
+  return request(`/api/availability/report/${jobId}/result`)
+}
